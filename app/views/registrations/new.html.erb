<% content_for :title, "Sign up" %>

<div class="mx-auto w-full max-w-md">
  <h1 class="text-3xl font-bold tracking-tight">Create your account</h1>
  <p class="mt-1 text-gray-500">Start your weekly reset with Back On Track.</p>

  <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4" do |form| %>
    <%= render "shared/form_errors", model: @user %>

    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :name, autocomplete: "name",
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :email_address, "Email", class: "block text-sm font-medium text-gray-700" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username",
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-700" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :week_starts_on, "Week starts on", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :week_starts_on, User::WEEK_START_DAYS.map { |d| [d.capitalize, d] }, {},
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>

    <%= form.submit "Create account", class: "w-full rounded-lg bg-emerald-600 px-4 py-2.5 font-medium text-white hover:bg-emerald-500 cursor-pointer" %>
  <% end %>

  <p class="mt-4 text-sm text-gray-500">
    Already have an account? <%= link_to "Sign in", new_session_path, class: "font-medium text-emerald-600 hover:underline" %>
  </p>
</div>
