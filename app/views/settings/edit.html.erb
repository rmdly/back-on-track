<% content_for :title, "Edit settings" %>

<header class="mb-6">
  <%= link_to "← Settings", settings_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
  <h1 class="mt-2 text-2xl font-bold tracking-tight">Edit settings</h1>
</header>

<%= form_with model: @user, url: settings_path, method: :patch, class: "space-y-4" do |form| %>
  <%= render "shared/form_errors", model: @user %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name,
          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
  </div>

  <div>
    <%= form.label :week_starts_on, "Week starts on", class: "block text-sm font-medium text-gray-700" %>
    <%= form.select :week_starts_on, User::WEEK_START_DAYS.map { |d| [d.capitalize, d] }, {},
          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
  </div>

  <div>
    <%= form.label :time_zone, "Time zone", class: "block text-sm font-medium text-gray-700" %>
    <%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.all, {},
          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
  </div>

  <div class="flex gap-2">
    <%= form.submit "Save", class: "rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-500 cursor-pointer" %>
    <%= link_to "Cancel", settings_path, class: "rounded-lg border border-gray-300 bg-white px-4 py-2 font-medium text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
