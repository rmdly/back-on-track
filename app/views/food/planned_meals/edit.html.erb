<% content_for :title, "Edit planned meal" %>
<header class="mb-6">
  <%= link_to "← Back to plan", food_plan_path(date: @planned_meal.planned_on), class: "text-sm text-gray-500 hover:text-gray-900" %>
  <h1 class="mt-2 text-2xl font-bold tracking-tight">Edit planned meal</h1>
</header>

<%= form_with model: @planned_meal, url: food_planned_meal_path(@planned_meal), class: "space-y-4" do |form| %>
  <%= render "shared/form_errors", model: @planned_meal %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name,
          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :planned_on, "Day", class: "block text-sm font-medium text-gray-700" %>
      <%= form.date_field :planned_on,
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
    <div>
      <%= form.label :meal_type, "Type", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :meal_type, PlannedMeal.meal_types.keys.map { |t| [t.humanize, t] }, {},
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
  </div>

  <div class="flex gap-2">
    <%= form.submit "Save", class: "rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-500 cursor-pointer" %>
    <%= link_to "Cancel", food_plan_path(date: @planned_meal.planned_on), class: "rounded-lg border border-gray-300 bg-white px-4 py-2 font-medium text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
