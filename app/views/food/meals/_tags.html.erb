<%# locals: meal: — small badges for cheap / high-protein / quick %>
<% if meal.cheap? %>
  <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Cheap</span>
<% end %>
<% if meal.high_protein? %>
  <span class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-700">High protein</span>
<% end %>
<% if meal.quick? %>
  <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-700">Quick</span>
<% end %>
