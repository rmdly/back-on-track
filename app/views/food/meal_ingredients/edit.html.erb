<% content_for :title, "Edit ingredient" %>
<header class="mb-6">
  <%= link_to "← Back to meal", food_meal_path(@meal), class: "text-sm text-gray-500 hover:text-gray-900" %>
  <h1 class="mt-2 text-2xl font-bold tracking-tight">Edit ingredient</h1>
</header>

<%= form_with model: @meal_ingredient, url: food_meal_ingredient_path(@meal_ingredient), class: "space-y-4" do |form| %>
  <%= render "shared/form_errors", model: @meal_ingredient %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name,
          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :quantity, "Qty", class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :quantity, step: "0.01", min: "0",
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
    <div>
      <%= form.label :unit, "Unit", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :unit,
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
  </div>

  <div class="flex gap-2">
    <%= form.submit "Save", class: "rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-500 cursor-pointer" %>
    <%= link_to "Cancel", food_meal_path(@meal), class: "rounded-lg border border-gray-300 bg-white px-4 py-2 font-medium text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
