<% content_for :title, "Shopping" %>
<%= render "shopping/subnav" %>

<header class="mb-4 flex items-end justify-between">
  <h1 class="text-2xl font-bold tracking-tight">Shopping lists</h1>
  <%= link_to "New list", new_shopping_shopping_list_path,
        class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500" %>
</header>

<% if @shopping_lists.any? %>
  <div class="space-y-2">
    <% @shopping_lists.each do |list| %>
      <%= link_to shopping_shopping_list_path(list),
            class: "block rounded-xl border border-gray-200 bg-white px-4 py-3 hover:border-emerald-400" do %>
        <div class="flex items-center justify-between">
          <p class="font-medium text-gray-900"><%= list.name %></p>
          <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= list.completed? ? 'bg-emerald-100 text-emerald-700' : 'bg-gray-100 text-gray-600' %>">
            <%= list.status.humanize %>
          </span>
        </div>
        <div class="mt-1 flex flex-wrap gap-3 text-xs text-gray-500">
          <% if list.store %><span><%= list.store.name %></span><% end %>
          <span><%= pluralize(list.shopping_list_items.size, "item") %></span>
          <span>Est. <%= money(list.estimated_total_cents) %></span>
          <% if list.budget_cents %>
            <span class="<%= budget_status_class(list) %>">Budget <%= money(list.budget_cents) %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state",
        message: "Create this week’s shopping list and start building your affordable food shop.",
        action_label: "Create a list", action_path: new_shopping_shopping_list_path %>
<% end %>
