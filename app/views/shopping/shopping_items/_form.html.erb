<%= form_with model: shopping_item, url: url, class: "space-y-4" do |form| %>
  <%= render "shared/form_errors", model: shopping_item %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, autofocus: true, placeholder: "e.g. Chicken breast",
          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :category, class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :category, ShoppingItem::CATEGORIES.map { |c| [c.humanize, c] }, { include_blank: "None" },
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
    <div>
      <%= form.label :store_id, "Usual store", class: "block text-sm font-medium text-gray-700" %>
      <%= form.collection_select :store_id, Current.user.stores.ordered, :id, :name, { include_blank: "Any" },
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div>
      <%= form.label :default_quantity, "Qty", class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :default_quantity, step: "0.01", min: "0",
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
    <div>
      <%= form.label :default_unit, "Unit", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :default_unit, placeholder: "kg, pack…",
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
    <div>
      <%= form.label :estimated_unit_price, "Price £", class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :estimated_unit_price, step: "0.01", min: "0",
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
  </div>

  <label class="flex items-center gap-2">
    <%= form.check_box :active, class: "h-4 w-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500" %>
    <span class="text-sm text-gray-700">Active</span>
  </label>

  <div class="flex gap-2">
    <%= form.submit submit_label, class: "rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-500 cursor-pointer" %>
    <%= link_to "Cancel", shopping_shopping_items_path, class: "rounded-lg border border-gray-300 bg-white px-4 py-2 font-medium text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
