<% tabs = [
     ["Lists", shopping_shopping_lists_path, "shopping_lists"],
     ["Items", shopping_shopping_items_path, "shopping_items"],
     ["Stores", shopping_stores_path, "stores"]
   ] %>
<nav class="mb-5 flex gap-1 rounded-lg bg-gray-100 p-1 text-sm font-medium">
  <% tabs.each do |label, path, name| %>
    <% active = controller_name == name %>
    <%= link_to label, path,
          class: "flex-1 rounded-md px-3 py-1.5 text-center transition-colors #{active ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-500 hover:text-gray-900'}" %>
  <% end %>
</nav>
