<%= form_with model: exercise, url: url, class: "space-y-4" do |form| %>
  <%= render "shared/form_errors", model: exercise %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, autofocus: true, placeholder: "e.g. Bench Press",
          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :exercise_type, "Type", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :exercise_type, Exercise.exercise_types.keys.map { |t| [t.humanize, t] }, {},
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
    <div>
      <%= form.label :muscle_group, "Muscle group", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :muscle_group, Exercise::MUSCLE_GROUPS.map { |g| [g.humanize, g] }, { include_blank: "—" },
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= form.label :equipment, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :equipment, placeholder: "Barbell, dumbbell…",
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
    <div>
      <%= form.label :default_unit, "Unit", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :default_unit, placeholder: "kg",
            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500" %>
    </div>
  </div>

  <label class="flex items-center gap-2">
    <%= form.check_box :active, class: "h-4 w-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500" %>
    <span class="text-sm text-gray-700">Active</span>
  </label>

  <div class="flex gap-2">
    <%= form.submit submit_label, class: "rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-500 cursor-pointer" %>
    <%= link_to "Cancel", training_exercises_path, class: "rounded-lg border border-gray-300 bg-white px-4 py-2 font-medium text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
