<% content_for :title, "Templates" %>
<%= render "training/subnav" %>

<header class="mb-4 flex items-end justify-between">
  <h1 class="text-2xl font-bold tracking-tight">Workout templates</h1>
  <%= link_to "New template", new_training_workout_template_path,
        class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500" %>
</header>

<% if @workout_templates.any? %>
  <div class="space-y-2">
    <% @workout_templates.each do |template| %>
      <%= link_to training_workout_template_path(template),
            class: "block rounded-xl border border-gray-200 bg-white px-4 py-3 hover:border-emerald-400 #{'opacity-60' unless template.active?}" do %>
        <p class="font-medium text-gray-900"><%= template.name %></p>
        <p class="mt-0.5 text-xs text-gray-500"><%= pluralize(template.workout_template_exercises.size, "exercise") %></p>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state",
        message: "Create your first workout template, like Push Day or Full Body.",
        action_label: "New template", action_path: new_training_workout_template_path %>
<% end %>
