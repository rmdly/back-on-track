<% content_for :title, @workout_session.name.presence || "Workout" %>

<header class="mb-5">
  <%= link_to "← Workouts", training_workout_sessions_path, class: "text-sm text-gray-500 hover:text-gray-900" %>
  <div class="mt-2 flex items-start justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight"><%= @workout_session.name.presence || "Workout" %></h1>
      <p class="text-sm text-gray-500"><%= @workout_session.performed_on.strftime("%A %-d %b") %></p>
    </div>
    <%= button_to "Delete", training_workout_session_path(@workout_session), method: :delete,
          class: "rounded-md px-2 py-1 text-sm text-gray-500 hover:bg-red-50 hover:text-red-600",
          form: { data: { turbo_confirm: "Delete this workout?" } } %>
  </div>
</header>

<%= render "training/workout_sessions/session_body", workout_session: @workout_session, new_workout_exercise: @workout_exercise %>
